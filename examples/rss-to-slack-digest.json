{
  "name": "Daily AI news digest to Slack",
  "nodes": [
    {
      "name": "Every morning 9am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": { "rule": { "interval": [{ "field": "days", "triggerAtHour": 9 }] } }
    },
    {
      "name": "Read RSS feed",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.1,
      "position": [220, 0],
      "parameters": { "url": "https://www.anthropic.com/rss.xml" }
    },
    {
      "name": "Keep last 24h",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [440, 0],
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ DateTime.fromISO($json.isoDate) }}",
              "rightValue": "={{ $now.minus({ days: 1 }) }}",
              "operator": { "type": "dateTime", "operation": "after" }
            }
          ]
        }
      }
    },
    {
      "name": "Summarize with Claude",
      "type": "@n8n/n8n-nodes-langchain.anthropic",
      "typeVersion": 1,
      "position": [660, 0],
      "parameters": {
        "modelId": "claude-opus-5-5",
        "messages": { "values": [{ "content": "=Summarize in 2 lines for a busy founder:\n{{ $json.title }}\n{{ $json.contentSnippet }}" }] }
      },
      "credentials": { "anthropicApi": { "id": "CREATE_ME", "name": "Anthropic account" } }
    },
    {
      "name": "Post to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [880, 0],
      "parameters": { "select": "channel", "channelId": { "__rl": true, "mode": "name", "value": "#ai-news" }, "text": "={{ $json.content[0].text }}" },
      "credentials": { "slackApi": { "id": "CREATE_ME", "name": "Slack account" } }
    }
  ],
  "connections": {
    "Every morning 9am": { "main": [[{ "node": "Read RSS feed", "type": "main", "index": 0 }]] },
    "Read RSS feed": { "main": [[{ "node": "Keep last 24h", "type": "main", "index": 0 }]] },
    "Keep last 24h": { "main": [[{ "node": "Summarize with Claude", "type": "main", "index": 0 }]] },
    "Summarize with Claude": { "main": [[{ "node": "Post to Slack", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
